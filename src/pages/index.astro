---
const title = 'Cronos — work in progress';
const description = 'Histomap interactivo de la historia humana — civilizaciones, religiones, figuras y eventos clave en lanes paralelas.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fafaf7;
        --fg: #1a1a1a;
        --muted: #6b6b6b;
        --accent: #8b0000;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a1a;
          --fg: #fafaf7;
          --muted: #9a9a9a;
          --accent: #d97757;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
      }
      main {
        max-width: 720px;
        margin: 4rem auto;
        padding: 0 1.5rem;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        margin: 0 0 1rem;
        color: var(--accent);
      }
      .lede { font-size: 1.15rem; color: var(--muted); }
      .status {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--accent);
        background: color-mix(in srgb, var(--bg) 95%, var(--accent));
        font-size: 0.95rem;
      }
      code {
        background: color-mix(in srgb, var(--bg) 88%, var(--fg));
        padding: 0.15em 0.4em;
        border-radius: 3px;
        font-size: 0.9em;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Cronos</h1>
      <p class="lede">{description}</p>
      <div class="status">
        <strong>Estado:</strong> en construcción. Bootstrap (F1) completo. Falta data ingest (F3-F5) y el histomap D3 (F7-F9).
      </div>
      <p>Ver <code>PLAN.md</code> en el repo para el plan completo (F1-F11).</p>
    </main>
  </body>
</html>
