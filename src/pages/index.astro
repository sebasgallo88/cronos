---
import HistomapCanvas from '../components/HistomapCanvas.tsx';
import cronosRaw from '../data/cronos.json';
import type { CronosData } from '../lib/dataTypes';

const cronos = cronosRaw as unknown as CronosData;
const { polity_count, religion_count, figure_count, event_count, time_range } = cronos.meta;

const title = 'Cronos — Histomap';
const description = 'Histomap interactivo de la historia humana — civilizaciones, religiones, figuras y eventos clave en lanes paralelas.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fafaf7;
        --bg-elevated: #ffffff;
        --fg: #1a1a1a;
        --muted: #6b6b6b;
        --accent: #8b0000;
        --border: #e4e4dd;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a1a;
          --bg-elevated: #232323;
          --fg: #fafaf7;
          --muted: #9a9a9a;
          --accent: #d97757;
          --border: #383838;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.5;
      }
      header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
      }
      h1 {
        margin: 0;
        font-size: 1.5rem;
        color: var(--accent);
      }
      .subtitle {
        font-size: 0.9rem;
        color: var(--muted);
      }
      .stats {
        font-size: 0.85rem;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      main {
        padding: 1.25rem 1.5rem;
        max-width: 1600px;
        margin: 0 auto;
      }
      .status-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <div>
        <h1>Cronos</h1>
        <p class="subtitle">{description}</p>
      </div>
      <div class="stats">
        <span class="status-badge">F7 v0 (single lane)</span>
        {polity_count}p · {religion_count}r · {figure_count}f · {event_count}e
        · rango {time_range[0]} → {time_range[1]}
      </div>
    </header>
    <main>
      <HistomapCanvas data={cronos} client:visible />
      <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--muted);">
        Tip: rueda del mouse o pinch para zoom; click-drag horizontal para pan. F8 agregará lanes
        para todos los polities con filtros por región / religión / tipo / era.
      </p>
    </main>
  </body>
</html>
